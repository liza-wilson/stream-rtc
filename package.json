{
  "name": "stream-rtc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run build:control && npm run build:relay",
    "build:control": "esbuild packages/control-plane/src/main.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:ws --external:jsonwebtoken --external:zod --external:prom-client --outfile=dist/control/main.js",
    "build:relay": "esbuild packages/media-relay/src/main.ts --bundle --platform=node --format=esm --target=node22 --external:ws --external:jsonwebtoken --external:zod --external:prom-client --outfile=dist/relay/main.js",
    "start:control": "node dist/control/main.js",
    "start:relay": "node dist/relay/main.js",
    "dev:control": "npm run build:control && npm run start:control",
    "dev:relay": "npm run build:relay && npm run start:relay",
    "smoke": "npm run build && esbuild tools/smoke.ts --bundle --platform=node --format=esm --target=node22 --external:ws --external:jsonwebtoken --outfile=dist/smoke.js && node dist/smoke.js"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.9",
    "jsonwebtoken": "^9.0.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
